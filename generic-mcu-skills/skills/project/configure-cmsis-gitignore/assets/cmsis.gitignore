# CMSIS ignore template: keep or adapt rules verified for the selected solution.
# A leading / anchors a rule to the directory containing this .gitignore.
# Optional patterns below are inactive comments. The skill enables a verified
# pattern by removing its leading "# " in the project's .gitignore.
# Keep source files, pack locks (*.cbuild-pack.yml), and RTE configuration.

# Default build-output directory; adjust for custom output-dirs settings.
/out/

# Intermediate build files that can be regenerated.
/tmp/

# Generated context build descriptions, solution index, and run/debug metadata.
/*.cbuild.yml
/*.cbuild-idx.yml
/*.cbuild-run.yml

# Generated solution-local tools-environment export; keep other .cmsis files.
# Retain the export if maintained as a project input.
/.cmsis/tools-environment.yml

# Log produced by uv2csolution project conversion.
/uv2csolution.log

# Legacy generated intermediate projects; retain manually maintained projects.
/*.cprj

# Optional local context selection; retain it when shared by the project.
# /*.cbuild-set.yml

# Optional generated headers in RTE context directories, when regeneration is
# verified. Never exclude the complete RTE directory or user configuration.
# **/RTE/_*/RTE_Components.h
# **/RTE/_*/Pre_Include_*.h

# Optional generated clangd configuration; retain user-authored settings.
# /.clangd

# Optional JSON files generated by CMSIS Solution. Inspect each file for shared
# or user-authored settings before excluding it; keep .vscode.d/ drop-ins.
# /.vscode/cmsis.json
# /.vscode/launch.json
# /.vscode/tasks.json
# /.vscode/settings.json

# Optional generated J-Link command file; retain user-maintained commands.
# /.cmd.jlink

# Optional SDS runtime captures; retain input datasets and reference captures.
# /*.[sS][dD][sS]

# Optional SDS I/O log produced by workflows such as FVP runs.
# /sdsio.log

# Optional Python bytecode caches, including those produced by FVP/SDS helpers.
# **/__pycache__/

# An existing *.d dependency-file rule also hides .vscode.d/ directories.
# Enable this exception after that rule when authorized, then check descendants.
# No *.d rule is added here; CMSIS drop-ins are user-managed source files.
# !.vscode.d/

# Leave *.update@* configuration updates visible until reviewed and merged.
# Do not add blanket binary/library exclusions: prebuilt files can be inputs.
